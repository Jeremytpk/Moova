{
  "expo": {
    "name": "Moova",
    "slug": "moova-logistics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoMoova.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logoMoova.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jerttech.moova"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoMoova.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.jerttech.moova",
      "permissions": [
        "DETECT_SCREEN_CAPTURE"
      ]
    },
    "web": {
  "favicon": "./assets/logoMoova.png"
    }
  }
}
